<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HassWebView.Core"
             x:Class="HassWebView.Core.Controls.WebViewWithCursor">
    <AbsoluteLayout x:Name="root">
        <local:HassWebView
            x:Name="wv"
            UserAgent="Mozilla/5.0 (Linux; Android 14; Generic Device) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"/>
        <Border x:Name="cursor"
                BackgroundColor="{StaticResource Primary}"
                Stroke="{StaticResource PrimaryDark}"
                StrokeThickness="1"
                WidthRequest="20"
                HeightRequest="20"
                IsVisible="False"
                AbsoluteLayout.LayoutFlags="None"
                AbsoluteLayout.LayoutBounds="100,100,20,20"
                Opacity="0.9">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
        </Border>
        <!-- 顶部加载进度条 -->
        <BoxView x:Name="loadingBar"
                 BackgroundColor="{StaticResource Primary}"
                 HeightRequest="3"
                 IsVisible="False"
                 AbsoluteLayout.LayoutFlags="WidthProportional"
                 AbsoluteLayout.LayoutBounds="0,0,0,3" />
        <!-- Toast 提示 -->
        <Border x:Name="toastPanel"
                IsVisible="False"
                BackgroundColor="#E0323232"
                StrokeThickness="0"
                Opacity="0"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="0.5,0.92,AutoSize,AutoSize"
                Padding="16,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label x:Name="toastLabel"
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>
        <!-- Alert 对话框遮罩 -->
        <BoxView x:Name="alertOverlay"
                 IsVisible="False"
                 BackgroundColor="#CC000000"
                 AbsoluteLayout.LayoutFlags="All"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 Opacity="0" />
        <!-- Alert 对话框 -->
        <Border x:Name="alertPanel"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#2C2C2E'}"
                StrokeThickness="0"
                Opacity="0"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                Padding="24"
                WidthRequest="280">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.3" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">
                <Label x:Name="alertTitle"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light='#000000', Dark='#FFFFFF'}"
                       HorizontalOptions="Center" />
                <Label x:Name="alertMessage"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light='#666666', Dark='#8E8E93'}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <HorizontalStackLayout Spacing="12">
                    <Button x:Name="alertCancelBtn"
                            Text="取消"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light='#666666', Dark='#8E8E93'}"
                            BackgroundColor="{AppThemeBinding Light='#F2F2F7', Dark='#3A3A3C'}"
                            BorderWidth="0"
                            CornerRadius="8"
                            Flex="1"
                            HeightRequest="44"
                            Clicked="OnAlertCancelClicked" />
                    <Button x:Name="alertAcceptBtn"
                            Text="确定"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="{StaticResource Primary}"
                            BorderWidth="0"
                            CornerRadius="8"
                            Flex="1"
                            HeightRequest="44"
                            Clicked="OnAlertAcceptClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </AbsoluteLayout>
</ContentView>