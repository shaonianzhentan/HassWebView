<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:HassWebView.Core"
             x:Class="HassWebView.Core.Views.HassPage"
             Shell.NavBarIsVisible="False">
    <AbsoluteLayout x:Name="root">

        <core:HassWebView 
            x:Name="wv"
            UserAgent="Mozilla/5.0 (Linux; Android 14; Generic Device) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"/>

        <!-- Cursor Element (replaces Frame with Border) -->
        <Border x:Name="cursor"
                BackgroundColor="{StaticResource Primary}"
                Stroke="{StaticResource PrimaryDark}"
                StrokeThickness="1"
                WidthRequest="20"
                HeightRequest="20"
                IsVisible="False"
                AbsoluteLayout.LayoutFlags="None"
                AbsoluteLayout.LayoutBounds="100,100,20,20"
                Opacity="0.9">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
        </Border>
    </AbsoluteLayout>
</ContentPage>
