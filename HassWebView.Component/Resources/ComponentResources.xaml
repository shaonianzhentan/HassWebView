<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="HassWebView.Component.Resources.ComponentResources">
    <Color x:Key="LightBackgroundColor">#F5F5F7</Color>
    <Color x:Key="DarkBackgroundColor">#000000</Color>
    <Color x:Key="LightCardColor">#FFFFFF</Color>
    <Color x:Key="DarkCardColor">#2C2C2E</Color>
    <Color x:Key="LightTextColor">#1D1D1F</Color>
    <Color x:Key="DarkTextColor">#FFFFFF</Color>
    <Color x:Key="LightBorderColor">#E5E5EA</Color>
    <Color x:Key="DarkBorderColor">#3A3A3C</Color>

    <Style x:Key="SectionHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#86868B, Dark=#8E8E93}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="AccentLinkLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}" />
    </Style>

    <Style x:Key="ButtonCardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="ButtonCardStateStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#636366, Dark=#8E8E93}" />
    </Style>

    <Style x:Key="SwitchCardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="SliderCardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="SliderCardValueStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="InfoRowTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#636366, Dark=#8E8E93}" />
    </Style>

    <Style x:Key="InfoRowValueStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <Style x:Key="EntityRowTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="EntityRowStateStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#636366, Dark=#8E8E93}" />
    </Style>

    <Style x:Key="CheckBoxListItemTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="DetailCardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="DetailCardSubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#636366, Dark=#8E8E93}" />
    </Style>

    <Style x:Key="DetailCardStateStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#34C759, Dark=#30D158}" />
    </Style>
</ResourceDictionary>
