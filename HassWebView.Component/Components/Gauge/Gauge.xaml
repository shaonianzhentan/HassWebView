<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.Gauge"
             x:Name="this">

    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
        <Label x:Name="ValueLabel"
               Text="0%"
               FontSize="{DynamicResource ComponentTitleSizeExtraLarge}"
               FontAttributes="Bold"
               TextColor="{DynamicResource PrimaryTextColor}" />
        <Label x:Name="LabelLabel"
               Text="{Binding Source={x:Reference this}, Path=Label}"
               FontSize="{DynamicResource ComponentBodySizeSmall}"
               TextColor="{DynamicResource SecondaryTextColor}"
               HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentView>