<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.Gauge"
             x:Name="this">

    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" WidthRequest="120">
        <Frame x:Name="GaugeFrame" 
               WidthRequest="120" 
               HeightRequest="120"
               CornerRadius="60"
               BackgroundColor="#F5F5F5"
               Padding="0"
               HorizontalOptions="Center">
            <Grid>
                <!-- 背景圆环 -->
                <BoxView x:Name="BackgroundBox"
                         CornerRadius="56" 
                         WidthRequest="112" 
                         HeightRequest="112" 
                         BackgroundColor="#E5E5EA" 
                         HorizontalOptions="Center" 
                         VerticalOptions="Center" />
                
                <!-- 中心内容 -->
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                    <Label x:Name="ValueLabel"
                           Text="0"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
                    <Label x:Name="UnitLabel"
                           Text="{Binding Source={x:Reference this}, Path=Unit}"
                           FontSize="12"
                           TextColor="#86868B"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                <!-- 进度遮罩层（模拟环形进度） -->
                <BoxView x:Name="ProgressBox"
                         CornerRadius="56"
                         WidthRequest="112"
                         HeightRequest="112"
                         BackgroundColor="#007AFF"
                         Opacity="0.3"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />
            </Grid>
        </Frame>
        
        <!-- 标签 -->
        <Label x:Name="LabelLabel"
               Text="{Binding Source={x:Reference this}, Path=Label}"
               FontSize="12"
               TextColor="#86868B"
               HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentView>