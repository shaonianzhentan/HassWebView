<?xml version="1.0" encoding="utf-8" ?>
<base:SizeableComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        x:Class="HassWebView.Component.Components.FeatureItem"
                        x:Name="this">

    <HorizontalStackLayout Spacing="12">
        <Label Text="✅">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentIconSizePhoneSmall}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                            <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTabletSmall}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                            <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTVSmall}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
        <Label x:Name="FeatureText"
               Text="{Binding Source={x:Reference this}, Path=Text}"
               TextColor="{StaticResource PrimaryTextColor}">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneSmall}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletSmall}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVSmall}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </HorizontalStackLayout>

</base:SizeableComponent>
