<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.ButtonCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            StrokeShape="RoundRectangle 12"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="IconLabel"
                       Text="{Binding Source={x:Reference this}, Path=Icon}"
                       FontSize="36"
                       VerticalOptions="Center" />
                <Border x:Name="BadgeBorder"
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="6,3"
                        IsVisible="{Binding Source={x:Reference this}, Path=ShowBadge}"
                        BackgroundColor="#FF9500">
                    <Label Text="!" FontSize="10" TextColor="White" FontAttributes="Bold" />
                </Border>
            </Grid>
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}"
                   LineBreakMode="TailTruncation" />
            <Label x:Name="StateLabel"
                   Text="{Binding Source={x:Reference this}, Path=State}"
                   FontSize="12"
                   TextColor="{Binding Source={x:Reference this}, Path=StateColor}" />
        </VerticalStackLayout>
    </Border>

</ContentView>