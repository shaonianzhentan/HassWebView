<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Components.ButtonCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            Padding="{DynamicResource ComponentPaddingMedium}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.Stroke>
            <SolidColorBrush Color="{DynamicResource BorderColor}" />
        </Border.Stroke>
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="IconLabel"
                       Text="{Binding Source={x:Reference this}, Path=Icon}"
                       FontSize="{DynamicResource ComponentIconSizeMedium}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center" />
                <!-- 状态指示器 -->
                <Border x:Name="StatusIndicator"
                        Grid.Column="1"
                        WidthRequest="12"
                        HeightRequest="12"
                        BackgroundColor="{DynamicResource ButtonCardBadgeBackgroundColor}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference this}, Path=StateColorType}"
                                     Value="{x:Static local:StateColorType.Success}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference this}, Path=StateColorType}"
                                     Value="{x:Static local:StateColorType.Warning}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource WarningColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference this}, Path=StateColorType}"
                                     Value="{x:Static local:StateColorType.Error}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ErrorColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference this}, Path=StateColorType}"
                                     Value="{x:Static local:StateColorType.Default}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TertiaryTextColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="{DynamicResource ComponentTitleSizeMedium}"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold" />
            <Label x:Name="StateLabel"
                   Text="{Binding Source={x:Reference this}, Path=State}"
                   FontSize="{DynamicResource ComponentBodySizeMedium}"
                   TextColor="{Binding Source={x:Reference this}, Path=StateColor}" />
        </VerticalStackLayout>
    </Border>

</ContentView>