<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HassWebView.Component"
             x:Class="HassWebView.Component.ButtonCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            StrokeThickness="0"
            Padding="12,14">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.BackgroundColor>
            <AppThemeBinding Light="#FFFFFF" Dark="#2C2C2E" />
        </Border.BackgroundColor>
        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="8">

            <!-- Top row: icon shape + optional badge -->
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Icon shape (rounded square) -->
                <Border x:Name="IconBorder"
                        Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid>
                        <Image x:Name="IconImage"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="False" />
                        <Label x:Name="IconLabel"
                               FontSize="{StaticResource HaButtonIconFontSize}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Badge (optional, top-right) -->
                <local:StateBadge x:Name="Badge"
                                  Grid.Column="2"
                                  VerticalOptions="Start"
                                  IsVisible="False"
                                  Margin="0,4,4,0" />

            </Grid>

            <!-- Title -->
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="14"
                   FontAttributes="Bold"
                   MaxLines="2"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light='#000000', Dark='#FFFFFF'}" />

            <!-- State label -->
            <Label x:Name="StateLabel"
                   Text="{Binding Source={x:Reference this}, Path=State}"
                   FontSize="12">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=State}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=State}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </VerticalStackLayout>
    </Border>

</ContentView>
