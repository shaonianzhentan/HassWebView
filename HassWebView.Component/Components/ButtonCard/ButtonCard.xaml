<?xml version="1.0" encoding="utf-8" ?>
<base:AdaptiveComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:local="clr-namespace:HassWebView.Component.Components"
                         xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                         xmlns:models="clr-namespace:HassWebView.Component.Models"
                         x:Class="HassWebView.Component.Components.ButtonCard"
                         x:Name="this">

    <Border x:Name="CardBorder"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            Padding="{DynamicResource ComponentPaddingPhoneMedium}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource ComponentPaddingPhoneMedium}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTabletMedium}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTVMedium}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.Stroke>
            <SolidColorBrush Color="{DynamicResource BorderColor}" />
        </Border.Stroke>
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="IconLabel"
                       Text="{Binding Source={x:Reference this}, Path=Icon}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Setter Property="FontSize" Value="{StaticResource ComponentIconSizePhoneMedium}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                    <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTabletMedium}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                    <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTVMedium}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
                <!-- 状态指示器 -->
                <Border x:Name="StatusIndicator"
                        Grid.Column="1"
                        WidthRequest="12"
                        HeightRequest="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BackgroundColor" Value="{StaticResource TertiaryTextColor}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Success}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Warning}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource WarningColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Error}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                </Border>
            </Grid>
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizePhoneMedium}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizeTabletMedium}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizeTVMedium}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
            <Label x:Name="StateLabel"
                   Text="{Binding Source={x:Reference this}, Path=State}">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneMedium}" />
                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletMedium}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVMedium}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Success}">
                                <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Warning}">
                                <Setter Property="TextColor" Value="{StaticResource WarningColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Error}">
                                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </VerticalStackLayout>
    </Border>

</base:AdaptiveComponent>
