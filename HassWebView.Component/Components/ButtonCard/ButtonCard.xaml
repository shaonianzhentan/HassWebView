<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.ButtonCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            Padding="16">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.Stroke>
            <SolidColorBrush Color="{DynamicResource BorderColor}" />
        </Border.Stroke>
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="IconLabel"
                       Text="{Binding Source={x:Reference this}, Path=Icon}"
                       FontSize="36"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center" />
                <Border x:Name="BadgeBorder"
                        Grid.Column="1"
                        Padding="6,3"
                        IsVisible="{Binding Source={x:Reference this}, Path=ShowBadge}"
                        BackgroundColor="#FF9500">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="!" FontSize="10" TextColor="White" FontAttributes="Bold" />
                </Border>
            </Grid>
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="16"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold" />
            <Label x:Name="StateLabel"
                   Text="{Binding Source={x:Reference this}, Path=State}"
                   FontSize="12"
                   TextColor="{Binding Source={x:Reference this}, Path=StateColor}" />
        </VerticalStackLayout>
    </Border>

</ContentView>