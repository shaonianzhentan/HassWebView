<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.EntityRow"
             x:Name="this">

    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16" ColumnSpacing="12">
        <!-- 图标区域 -->
        <Border x:Name="IconBorder"
                WidthRequest="48"
                HeightRequest="48"
                BackgroundColor="{Binding Source={x:Reference this}, Path=IconBackgroundColor}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Label x:Name="IconLabel"
                   Text="{Binding Source={x:Reference this}, Path=IconText}"
                   FontSize="24"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{Binding Source={x:Reference this}, Path=IconTextColor}"
                   LineBreakMode="NoWrap" />
        </Border>
        
        <!-- 内容区域 -->
        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="{DynamicResource ComponentTitleSizePhoneLarge}"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   FontAttributes="Bold" />
            <Label x:Name="StateLabel"
                   Text="{Binding Source={x:Reference this}, Path=State}"
                   FontSize="{DynamicResource ComponentBodySizePhoneMedium}"
                   TextColor="{Binding Source={x:Reference this}, Path=StateColor}" />
        </VerticalStackLayout>
        
        <!-- 箭头 -->
        <Label x:Name="ArrowLabel"
               Grid.Column="2"
               Text="›"
               FontSize="32"
               TextColor="{DynamicResource TertiaryTextColor}"
               VerticalOptions="Center" />
    </Grid>

</ContentView>