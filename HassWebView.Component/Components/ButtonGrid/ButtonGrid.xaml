<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HassWebView.Component"
             x:Class="HassWebView.Component.ButtonGrid"
             x:Name="this">

    <VerticalStackLayout Spacing="4">

        <!-- Optional section title -->
        <local:SectionHeader x:Name="HeaderSection"
                             Title="{Binding Source={x:Reference this}, Path=Title}"
                             IsVisible="False" />

        <!-- Grid built dynamically in code-behind -->
        <Grid x:Name="ButtonsGrid"
              ColumnSpacing="10"
              RowSpacing="10" />

    </VerticalStackLayout>

</ContentView>
