<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.SectionHeader"
             x:Name="this">

    <Grid ColumnDefinitions="*,Auto"
          Padding="16,8,16,4">

        <Label x:Name="TitleLabel"
               Grid.Column="0"
               Text="{Binding Source={x:Reference this}, Path=Title}"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#86868B, Dark=#8E8E93}"
               VerticalOptions="Center" />

        <Label x:Name="ActionLabel"
               Grid.Column="1"
               Text="{Binding Source={x:Reference this}, Path=Action}"
               FontSize="14"
               TextColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
               VerticalOptions="Center"
               IsVisible="False">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnActionTapped" />
            </Label.GestureRecognizers>
        </Label>

    </Grid>

</ContentView>