<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HassWebView.Component"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.Component.SwitchCard"
             x:Name="this">

    <local:Card Size="{Binding Source={x:Reference this}, Path=Size}">

        <!-- Main Content: Title and Description -->
        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <!-- Title Label -->
            <Label Text="{Binding Source={x:Reference this}, Path=Title}">
                <Label.Style>
                    <Style TargetType="Label" BasedOn="{StaticResource ListItemTitleLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="{x:Static models:ComponentSize.Small}">
                                <Setter Property="FontSize" Value="{StaticResource TitleFontSizeSmall}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="{x:Static models:ComponentSize.Large}">
                                <Setter Property="FontSize" Value="{StaticResource TitleFontSizeLarge}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>

            <!-- Optional Description Label -->
            <Label Text="{Binding Source={x:Reference this}, Path=Description}">
                <Label.Style>
                    <Style TargetType="Label" BasedOn="{StaticResource ListItemDescriptionLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="{x:Static models:ComponentSize.Small}">
                                <Setter Property="FontSize" Value="{StaticResource DescriptionFontSizeSmall}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="{x:Static models:ComponentSize.Large}">
                                <Setter Property="FontSize" Value="{StaticResource DescriptionFontSizeLarge}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
                <Label.Triggers>
                    <!-- Trigger to hide the label if Description is null or empty -->
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Description}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Description}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>

        <!-- Footer Content: The Switch -->
        <local:Card.Footer>
            <Switch VerticalOptions="Center"
                    IsToggled="{Binding Source={x:Reference this}, Path=IsToggled, Mode=TwoWay}"
                    Toggled="OnSwitchToggled"/>
        </local:Card.Footer>

    </local:Card>

</ContentView>
