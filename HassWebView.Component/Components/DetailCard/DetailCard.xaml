<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.DetailCard"
             x:Name="this">

    <Border x:Name="CardFrame"
            Padding="20"
            BackgroundColor="{DynamicResource CardBackgroundColor}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="8">
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryTextColor}" />
            <Label x:Name="SubtitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Subtitle}"
                   FontSize="14"
                   TextColor="{DynamicResource SecondaryTextColor}" />
            <Border x:Name="StateFrame"
                    Padding="12,6"
                    Margin="0,12,0,0"
                    BackgroundColor="{Binding Source={x:Reference this}, Path=StateColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="StateLabel"
                       Text="{Binding Source={x:Reference this}, Path=State}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>
    </Border>

</ContentView>
