<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.DetailCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            StrokeShape="RoundRectangle 16"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}">
        <VerticalStackLayout Spacing="8">
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
            <Label x:Name="SubtitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Subtitle}"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#636366, Dark=#8E8E93}" />
            <Border x:Name="StateBorder"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,6"
                    Margin="0,12,0,0"
                    BackgroundColor="{Binding Source={x:Reference this}, Path=StateColor}">
                <Label x:Name="StateLabel"
                       Text="{Binding Source={x:Reference this}, Path=State}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>
    </Border>

</ContentView>