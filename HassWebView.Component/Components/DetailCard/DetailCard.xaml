<?xml version="1.0" encoding="utf-8" ?>
<base:AdaptiveComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        xmlns:local="clr-namespace:HassWebView.Component.Components"
                        xmlns:models="clr-namespace:HassWebView.Component.Models"
                        x:Class="HassWebView.Component.Components.DetailCard"
                        x:Name="this">

    <Border x:Name="CardFrame"
            BackgroundColor="{StaticResource CardBackgroundColor}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource ComponentPaddingPhoneLarge}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTabletLarge}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTVLarge}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="8">
            <Label x:Name="TitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryTextColor}">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizePhoneLarge}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizeTabletLarge}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizeTVLarge}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
            <Label x:Name="SubtitleLabel"
                   Text="{Binding Source={x:Reference this}, Path=Subtitle}"
                   TextColor="{StaticResource SecondaryTextColor}">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneLarge}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletLarge}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVLarge}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
            <Border x:Name="StateFrame"
                    Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="Padding" Value="20,10" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="Padding" Value="28,14" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Default}">
                                <Setter Property="BackgroundColor" Value="{StaticResource TertiaryTextColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Success}">
                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Warning}">
                                <Setter Property="BackgroundColor" Value="{StaticResource WarningColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColorType}" Value="{x:Static local:StateColorType.Error}">
                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="StateLabel"
                       Text="{Binding Source={x:Reference this}, Path=State}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneMedium}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletMedium}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVMedium}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
            </Border>
        </VerticalStackLayout>
    </Border>

</base:AdaptiveComponent>
