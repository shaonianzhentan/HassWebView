<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HassWebView.Component"
             x:Class="HassWebView.Component.SettingsGroup"
             x:Name="this">

    <VerticalStackLayout Spacing="4">

        <!-- Optional section title -->
        <local:SectionHeader x:Name="HeaderSection"
                             Title="{Binding Source={x:Reference this}, Path=Title}"
                             IsVisible="False" />

        <!-- Card container -->
        <Border StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#2C2C2E'}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08" />
            </Border.Shadow>

            <VerticalStackLayout x:Name="ItemsContainer" Spacing="0" />
        </Border>

        <!-- Optional footer description -->
        <Label x:Name="FooterLabel"
               Text="{Binding Source={x:Reference this}, Path=Footer}"
               Style="{StaticResource ListItemDescriptionLabelStyle}"
               Padding="16,4"
               IsVisible="False" />

    </VerticalStackLayout>

</ContentView>
