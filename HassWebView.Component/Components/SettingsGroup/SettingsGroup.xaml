<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.SettingsGroup"
             x:Name="this">

    <Border BackgroundColor="#FFFFFF" Padding="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <VerticalStackLayout>
            <Label Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="13"
                   TextColor="#86868B"
                   FontAttributes="Bold"
                   Padding="16,12,16,8" />
            <ContentPresenter Content="{Binding Source={x:Reference this}, Path=Content}" />
        </VerticalStackLayout>
    </Border>

</ContentView>
