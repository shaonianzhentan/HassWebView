<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.SettingsGroup">

    <Frame CornerRadius="12"
           Padding="0"
           BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}">
        <VerticalStackLayout>
            <Label Text="{Binding Source={x:Reference this}, Path=Title}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#86868B, Dark=#8E8E93}"
                   Padding="16,12,16,8" />
            <ContentPresenter Content="{Binding Source={x:Reference this}, Path=Content}" />
        </VerticalStackLayout>
    </Frame>

</ContentView>
