<?xml version="1.0" encoding="utf-8" ?>
<base:SizeableComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        x:Class="HassWebView.Component.Components.ThemeSelector"
                        x:Name="this">

    <Border x:Name="MainBorder"
            BackgroundColor="{DynamicResource CardBackgroundColor}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource ComponentPaddingPhoneSmall}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTabletSmall}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTVSmall}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.Stroke>
            <SolidColorBrush Color="{StaticResource BorderColor}" />
        </Border.Stroke>
        <HorizontalStackLayout Spacing="4">
            <Button x:Name="LightBtn"
                    Text="☀️"
                    CornerRadius="8"
                    Clicked="OnThemeClicked"
                    CommandParameter="Light">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FontSize" Value="{StaticResource ComponentIconSizePhoneSmall}" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="WidthRequest" Value="100" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                                <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTabletSmall}" />
                                <Setter Property="Padding" Value="16,8" />
                                <Setter Property="WidthRequest" Value="120" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                                <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTVSmall}" />
                                <Setter Property="Padding" Value="20,10" />
                                <Setter Property="WidthRequest" Value="140" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="DarkBtn"
                    Text="🌙"
                    CornerRadius="8"
                    Clicked="OnThemeClicked"
                    CommandParameter="Dark">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FontSize" Value="{StaticResource ComponentIconSizePhoneSmall}" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="WidthRequest" Value="100" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                                <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTabletSmall}" />
                                <Setter Property="Padding" Value="16,8" />
                                <Setter Property="WidthRequest" Value="120" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                                <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTVSmall}" />
                                <Setter Property="Padding" Value="20,10" />
                                <Setter Property="WidthRequest" Value="140" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="SystemBtn"
                    Text="🔄"
                    CornerRadius="8"
                    Clicked="OnThemeClicked"
                    CommandParameter="System">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FontSize" Value="{StaticResource ComponentIconSizePhoneSmall}" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="WidthRequest" Value="100" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                                <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTabletSmall}" />
                                <Setter Property="Padding" Value="16,8" />
                                <Setter Property="WidthRequest" Value="120" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                                <Setter Property="FontSize" Value="{StaticResource ComponentIconSizeTVSmall}" />
                                <Setter Property="Padding" Value="20,10" />
                                <Setter Property="WidthRequest" Value="140" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </HorizontalStackLayout>
    </Border>

</base:SizeableComponent>
