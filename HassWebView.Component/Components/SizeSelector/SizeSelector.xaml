<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.SizeSelector"
             x:Name="this">

    <Border Padding="8"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <HorizontalStackLayout Spacing="4">
            <Button x:Name="MediumBtn"
                    Text="📱"
                    FontSize="16"
                    CornerRadius="8"
                    Padding="12,6"
                    Clicked="OnSizeClicked"
                    CommandParameter="Phone"
                    BackgroundColor="{DynamicResource SizeSelectorButtonBackgroundColor}"
                    TextColor="{DynamicResource SizeSelectorButtonTextColor}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Source={x:Reference this}, Path=IsPhoneSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource SizeSelectorButtonSelectedBackgroundColor}" />
                        <Setter Property="TextColor" Value="{DynamicResource SizeSelectorButtonSelectedTextColor}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button x:Name="LargeBtn"
                    Text="📲"
                    FontSize="16"
                    CornerRadius="8"
                    Padding="12,6"
                    Clicked="OnSizeClicked"
                    CommandParameter="Tablet"
                    BackgroundColor="{DynamicResource SizeSelectorButtonBackgroundColor}"
                    TextColor="{DynamicResource SizeSelectorButtonTextColor}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Source={x:Reference this}, Path=IsTabletSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource SizeSelectorButtonSelectedBackgroundColor}" />
                        <Setter Property="TextColor" Value="{DynamicResource SizeSelectorButtonSelectedTextColor}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button x:Name="ExtraLargeBtn"
                    Text="📺"
                    FontSize="16"
                    CornerRadius="8"
                    Padding="12,6"
                    Clicked="OnSizeClicked"
                    CommandParameter="TV"
                    BackgroundColor="{DynamicResource SizeSelectorButtonBackgroundColor}"
                    TextColor="{DynamicResource SizeSelectorButtonTextColor}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Source={x:Reference this}, Path=IsTVSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource SizeSelectorButtonSelectedBackgroundColor}" />
                        <Setter Property="TextColor" Value="{DynamicResource SizeSelectorButtonSelectedTextColor}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>
    </Border>

</ContentView>