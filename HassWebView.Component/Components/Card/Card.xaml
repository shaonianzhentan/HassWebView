<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.Card"
             x:Name="this">

    <Border x:Name="CardBorder"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardColor}, Dark={StaticResource DarkCardColor}}"
            Padding="16">
        <ContentPresenter Content="{Binding Source={x:Reference this}, Path=Content}" />
    </Border>

</ContentView>