<?xml version="1.0" encoding="utf-8" ?>
<base:SizeableComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:HassWebView.Component.Components"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        xmlns:models="clr-namespace:HassWebView.Component.Models"
                        x:Class="HassWebView.Component.Components.Alert"
                        x:Name="this">

    <Border x:Name="AlertBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="{DynamicResource ComponentPaddingPhoneMedium}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                        <Setter Property="Padding" Value="{DynamicResource ComponentPaddingTabletMedium}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                        <Setter Property="Padding" Value="{DynamicResource ComponentPaddingTVMedium}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Warning">
                        <Setter Property="BackgroundColor" Value="{DynamicResource AlertWarningBackgroundColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Error">
                        <Setter Property="BackgroundColor" Value="{DynamicResource AlertErrorBackgroundColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Success">
                        <Setter Property="BackgroundColor" Value="{DynamicResource AlertSuccessBackgroundColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Info">
                        <Setter Property="BackgroundColor" Value="{DynamicResource AlertInfoBackgroundColor}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Label x:Name="IconLabel"
                   Grid.Column="0"
                   VerticalOptions="Start"
                   Margin="0,4,0,0">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="{DynamicResource ComponentIconSizePhoneSmall}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="FontSize" Value="{DynamicResource ComponentIconSizeTabletSmall}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="FontSize" Value="{DynamicResource ComponentIconSizeTVSmall}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Warning">
                                <Setter Property="Text" Value="⚠️" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Error">
                                <Setter Property="Text" Value="❌" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Success">
                                <Setter Property="Text" Value="✓" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Info">
                                <Setter Property="Text" Value="ℹ️" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
            
            <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                <Label x:Name="TitleLabel"
                       Text="{Binding Source={x:Reference this}, Path=Title}"
                       FontAttributes="Bold">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Setter Property="FontSize" Value="{DynamicResource ComponentTitleSizePhoneSmall}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="Tablet">
                                    <Setter Property="FontSize" Value="{DynamicResource ComponentTitleSizeTabletSmall}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="TV">
                                    <Setter Property="FontSize" Value="{DynamicResource ComponentTitleSizeTVSmall}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Warning">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertWarningTitleColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Error">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertErrorTitleColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Success">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertSuccessTitleColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Info">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertInfoTitleColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
                
                <Label x:Name="MessageLabel"
                       Text="{Binding Source={x:Reference this}, Path=Message}"
                       LineBreakMode="WordWrap">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Setter Property="FontSize" Value="{DynamicResource ComponentBodySizePhoneSmall}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                    <Setter Property="FontSize" Value="{DynamicResource ComponentBodySizeTabletSmall}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                    <Setter Property="FontSize" Value="{DynamicResource ComponentBodySizeTVSmall}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Warning">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertWarningMessageColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Error">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertErrorMessageColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Success">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertSuccessMessageColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Type}" Value="Info">
                                    <Setter Property="TextColor" Value="{DynamicResource AlertInfoMessageColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
            </VerticalStackLayout>
            
            <Border x:Name="CloseButtonBorder"
                    Grid.Column="2"
                    WidthRequest="22"
                    HeightRequest="22"
                    Margin="8,0,0,0"
                    BackgroundColor="{DynamicResource AlertCloseButtonBackgroundColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </Border.GestureRecognizers>
                <Label Text="X"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AlertCloseButtonTextColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>
    </Border>

</base:SizeableComponent>
