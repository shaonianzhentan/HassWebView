<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.SliderCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            StrokeShape="RoundRectangle 12"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}">
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="TitleLabel"
                       Grid.Column="0"
                       Text="{Binding Source={x:Reference this}, Path=Title}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
                <Label x:Name="ValueLabel"
                       Grid.Column="1"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Source={x:Reference this}, Path=Value}" />
                            <Span Text="{Binding Source={x:Reference this}, Path=Unit}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
            <Slider x:Name="ValueSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding Source={x:Reference this}, Path=Value}"
                    ThumbColor="#007AFF"
                    MinimumTrackColor="#007AFF"
                    MaximumTrackColor="#8E8E93" />
        </VerticalStackLayout>
    </Border>

</ContentView>