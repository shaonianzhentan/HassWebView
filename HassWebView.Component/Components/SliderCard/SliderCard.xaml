<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.SliderCard"
             x:Name="this">

    <Border x:Name="CardBorder"
            Padding="16"
            BackgroundColor="{DynamicResource CardBackgroundColor}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="TitleLabel"
                       Grid.Column="0"
                       Text="{Binding Source={x:Reference this}, Path=Title}"
                       FontSize="14"
                       TextColor="{DynamicResource PrimaryTextColor}" />
                <Label x:Name="ValueLabel"
                       Grid.Column="1"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource PrimaryTextColor}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Source={x:Reference this}, Path=DisplayValue}" />
                            <Span Text="{Binding Source={x:Reference this}, Path=Unit}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
            <Slider x:Name="ValueSlider"
                    Minimum="{Binding Source={x:Reference this}, Path=Min}"
                    Maximum="{Binding Source={x:Reference this}, Path=Max}"
                    Value="{Binding Source={x:Reference this}, Path=Value}"
                    ThumbColor="{DynamicResource AccentColor}"
                    MinimumTrackColor="{DynamicResource AccentColor}"
                    MaximumTrackColor="{DynamicResource TertiaryTextColor}" />
        </VerticalStackLayout>
    </Border>

</ContentView>
