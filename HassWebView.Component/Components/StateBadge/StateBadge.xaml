<?xml version="1.0" encoding="utf-8" ?>
<base:AdaptiveComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        xmlns:local="clr-namespace:HassWebView.Component.Components"
                        xmlns:models="clr-namespace:HassWebView.Component.Models"
                        x:Class="HassWebView.Component.Components.StateBadge"
                        x:Name="this">

    <Border x:Name="BadgeBorder"
            Stroke="{StaticResource StateBadgeBorderColor}"
            StrokeThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource ComponentPaddingPhoneSmall}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTabletSmall}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTVSmall}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Success}">
                        <Setter Property="BackgroundColor" Value="{DynamicResource StateBadgeSuccessColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Warning}">
                        <Setter Property="BackgroundColor" Value="{DynamicResource StateBadgeWarningColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Error}">
                        <Setter Property="BackgroundColor" Value="{DynamicResource StateBadgeErrorColor}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Default}">
                        <Setter Property="BackgroundColor" Value="{DynamicResource StateBadgeDefaultColor}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Label x:Name="StateLabel"
               Text="{Binding Source={x:Reference this}, Path=State}"
               FontAttributes="Bold">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneSmall}" />
                    <Setter Property="TextColor" Value="{DynamicResource StateBadgeDefaultTextColor}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletSmall}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVSmall}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Success}">
                            <Setter Property="TextColor" Value="{DynamicResource StateBadgeSuccessTextColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Warning}">
                            <Setter Property="TextColor" Value="{DynamicResource StateBadgeWarningTextColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Error}">
                            <Setter Property="TextColor" Value="{DynamicResource StateBadgeErrorTextColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=StateColor}" Value="{x:Static local:StateColorType.Default}">
                            <Setter Property="TextColor" Value="{DynamicResource StateBadgeDefaultTextColor}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </Border>

</base:AdaptiveComponent>
