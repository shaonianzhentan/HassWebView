<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.StateBadge"
             x:Name="this">

    <Border x:Name="BadgeBorder"
            Padding="10,6"
            BackgroundColor="{Binding Source={x:Reference this}, Path=BadgeColor}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Label x:Name="StateLabel"
               Text="{Binding Source={x:Reference this}, Path=State}"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="White" />
    </Border>

</ContentView>