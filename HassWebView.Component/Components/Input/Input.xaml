<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.Input"
             x:Name="this">

    <VerticalStackLayout Spacing="4">
        <Label x:Name="LabelLabel"
               Text="{Binding Source={x:Reference this}, Path=Label}"
               FontSize="13"
               TextColor="{DynamicResource PrimaryTextColor}"
               IsVisible="{Binding Source={x:Reference this}, Path=ShowLabel}" />
        
        <Border x:Name="InputBorder"
                BackgroundColor="{DynamicResource InputBackgroundColor}"
                Padding="12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.Stroke>
                <SolidColorBrush Color="{DynamicResource BorderColor}" />
            </Border.Stroke>
            <Entry x:Name="InputEntry"
                   Text="{Binding Source={x:Reference this}, Path=Text, Mode=TwoWay}"
                   Placeholder="{Binding Source={x:Reference this}, Path=Placeholder}"
                   FontSize="16"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   PlaceholderColor="{DynamicResource TertiaryTextColor}"
                   BackgroundColor="Transparent"
                   IsPassword="{Binding Source={x:Reference this}, Path=IsPassword}"
                   Keyboard="{Binding Source={x:Reference this}, Path=KeyboardType}" />
        </Border>
        
        <Label x:Name="ErrorLabel"
               Text="{Binding Source={x:Reference this}, Path=ErrorText}"
               FontSize="12"
               TextColor="#FF3B30"
               IsVisible="{Binding Source={x:Reference this}, Path=HasError}" />
    </VerticalStackLayout>

</ContentView>