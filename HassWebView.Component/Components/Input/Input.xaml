<?xml version="1.0" encoding="utf-8" ?>
<base:AdaptiveComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        xmlns:models="clr-namespace:HassWebView.Component.Models"
                        x:Class="HassWebView.Component.Components.Input"
                        x:Name="this">

    <VerticalStackLayout Spacing="4">
        <Label x:Name="LabelLabel"
               Text="{Binding Source={x:Reference this}, Path=Label}"
               TextColor="{StaticResource PrimaryTextColor}"
               IsVisible="{Binding Source={x:Reference this}, Path=ShowLabel}">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneMedium}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletMedium}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVMedium}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
        
        <Border x:Name="InputBorder">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="{StaticResource ComponentPaddingPhoneMedium}" />
                    <Setter Property="BackgroundColor" Value="{StaticResource InputBackgroundColor}" />
                    <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                            <Setter Property="Padding" Value="{StaticResource ComponentPaddingTabletMedium}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                            <Setter Property="Padding" Value="{StaticResource ComponentPaddingTVMedium}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=IsFocused}" Value="true">
                            <Setter Property="Stroke" Value="{StaticResource AccentColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference this}, Path=HasError}" Value="true">
                            <Setter Property="Stroke" Value="{StaticResource ErrorColor}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Entry x:Name="InputEntry"
                   Text="{Binding Source={x:Reference this}, Path=Text, Mode=TwoWay}"
                   Placeholder="{Binding Source={x:Reference this}, Path=Placeholder}"
                   TextColor="{StaticResource PrimaryTextColor}"
                   PlaceholderColor="{StaticResource TertiaryTextColor}"
                   BackgroundColor="Transparent"
                   IsPassword="{Binding Source={x:Reference this}, Path=IsPassword}"
                   Keyboard="{Binding Source={x:Reference this}, Path=KeyboardType}">
                <Entry.Style>
                    <Style TargetType="Entry">
                        <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizePhoneMedium}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Entry" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizeTabletMedium}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Entry" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                                <Setter Property="FontSize" Value="{StaticResource ComponentTitleSizeTVMedium}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Entry.Style>
            </Entry>
        </Border>
        
        <Label x:Name="ErrorLabel"
               Text="{Binding Source={x:Reference this}, Path=ErrorText}"
               TextColor="{StaticResource ErrorColor}"
               IsVisible="{Binding Source={x:Reference this}, Path=HasError}">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneSmall}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.Tablet}">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletSmall}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=EffectiveSize}" Value="{x:Static models:ComponentSize.TV}">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVSmall}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </VerticalStackLayout>

</base:AdaptiveComponent>
