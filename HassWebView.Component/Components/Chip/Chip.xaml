<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.Chip"
             x:Name="this">

    <Border x:Name="ChipBorder"
            StrokeShape="RoundRectangle 16"
            Padding="10,6"
            BackgroundColor="#EFEFF4">
        <HorizontalStackLayout Spacing="6">
            <Label x:Name="IconLabel"
                   Text="{Binding Source={x:Reference this}, Path=IconText}"
                   FontSize="14"
                   IsVisible="{Binding Source={x:Reference this}, Path=ShowIcon}" />
            <Label x:Name="TextLabel"
                   Text="{Binding Source={x:Reference this}, Path=Text}"
                   FontSize="14"
                   TextColor="#1D1D1F" />
            <Button x:Name="CloseBtn"
                    Text="✕"
                    FontSize="12"
                    TextColor="#86868B"
                    BackgroundColor="Transparent"
                    WidthRequest="20"
                    HeightRequest="20"
                    IsVisible="{Binding Source={x:Reference this}, Path=Dismissible}"
                    Clicked="OnCloseClicked" />
        </HorizontalStackLayout>
    </Border>

</ContentView>