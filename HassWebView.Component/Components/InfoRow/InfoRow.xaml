<?xml version="1.0" encoding="utf-8" ?>
<base:SizeableComponent xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:base="clr-namespace:HassWebView.Component.Components.Base"
                        x:Class="HassWebView.Component.Components.InfoRow"
                        x:Name="this">

    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Padding" Value="{StaticResource ComponentPaddingPhoneSmall}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTabletSmall}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                        <Setter Property="Padding" Value="{StaticResource ComponentPaddingTVSmall}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Label x:Name="IconLabel"
               Grid.Column="0"
               Text="{Binding Source={x:Reference this}, Path=Icon}"
               HorizontalOptions="Center">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="16" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                            <Setter Property="FontSize" Value="18" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                            <Setter Property="FontSize" Value="22" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
        <Label x:Name="LabelLabel"
               Grid.Column="1"
               Text="{Binding Source={x:Reference this}, Path=Label}"
               TextColor="{StaticResource PrimaryTextColor}">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneSmall}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletSmall}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVSmall}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
        <Label x:Name="ValueLabel"
               Grid.Column="2"
               Text="{Binding Source={x:Reference this}, Path=Value}"
               TextColor="{StaticResource SecondaryTextColor}">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="{StaticResource ComponentBodySizePhoneMedium}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="Tablet">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTabletMedium}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference this}, Path=Size}" Value="TV">
                            <Setter Property="FontSize" Value="{StaticResource ComponentBodySizeTVMedium}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </Grid>

</base:SizeableComponent>
