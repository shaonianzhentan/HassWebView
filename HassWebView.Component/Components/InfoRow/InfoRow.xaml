<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.InfoRow"
             x:Name="this">

    <Grid ColumnDefinitions="*,Auto" Padding="16,8">
        <Label x:Name="TitleLabel"
               Grid.Column="0"
               Text="{Binding Source={x:Reference this}, Path=Title}"
               FontSize="14"
               TextColor="{AppThemeBinding Light=#636366, Dark=#8E8E93}" />
        <Label x:Name="ValueLabel"
               Grid.Column="1"
               Text="{Binding Source={x:Reference this}, Path=Value}"
               FontSize="14"
               TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}"
               HorizontalTextAlignment="End" />
    </Grid>

</ContentView>