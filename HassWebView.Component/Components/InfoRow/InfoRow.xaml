<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Component.Components.InfoRow"
             x:Name="this">

    <Grid ColumnDefinitions="40,*,Auto" Padding="{DynamicResource ComponentPaddingSmall}" ColumnSpacing="8">
        <Label x:Name="IconLabel"
               Grid.Column="0"
               Text="{Binding Source={x:Reference this}, Path=Icon}"
               FontSize="{DynamicResource ComponentIconSizePhoneSmall}"
               HorizontalOptions="Center" />
        <Label x:Name="LabelLabel"
               Grid.Column="1"
               Text="{Binding Source={x:Reference this}, Path=Label}"
               FontSize="{DynamicResource ComponentTitleSizeMedium}"
               TextColor="{DynamicResource PrimaryTextColor}" />
        <Label x:Name="ValueLabel"
               Grid.Column="2"
               Text="{Binding Source={x:Reference this}, Path=Value}"
               FontSize="{DynamicResource ComponentBodySizeMedium}"
               TextColor="{DynamicResource SecondaryTextColor}" />
    </Grid>

</ContentView>