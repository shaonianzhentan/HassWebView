<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HassWebView.Component.Styles">

    <!-- ========== HA 2026 DESIGN TOKENS ========== -->

    <!-- Page / Card background layers -->
    <Color x:Key="HaPageBackground">#F5F5F7</Color>
    <Color x:Key="HaPageBackgroundDark">#1C1C1E</Color>
    <Color x:Key="HaCardBackground">#FFFFFF</Color>
    <Color x:Key="HaCardBackgroundDark">#2C2C2E</Color>
    <Color x:Key="HaDividerColor">#E5E5EA</Color>
    <Color x:Key="HaDividerColorDark">#38383A</Color>

    <!-- State semantic colors -->
    <Color x:Key="HaStateOnColor">#FF9800</Color>
    <Color x:Key="HaStateOnColorDark">#FFA726</Color>
    <Color x:Key="HaStateOffColor">#9E9E9E</Color>
    <Color x:Key="HaStateOffColorDark">#757575</Color>
    <Color x:Key="HaStateUnavailableColor">#F44336</Color>
    <Color x:Key="HaStateUnavailableColorDark">#EF5350</Color>
    <Color x:Key="HaAccentColor">#039BE5</Color>
    <Color x:Key="HaAccentColorDark">#03A9F4</Color>
    <Color x:Key="HaSecondaryTextColor">#9E9E9E</Color>
    <Color x:Key="HaSecondaryTextColorDark">#8E8E93</Color>

    <!-- Icon shape sizes -->
    <x:Double x:Key="HaIconSize">40</x:Double>
    <x:Double x:Key="HaIconFontSize">20</x:Double>
    <x:Double x:Key="HaButtonIconSize">44</x:Double>
    <x:Double x:Key="HaButtonIconFontSize">24</x:Double>

    <!-- ========== SIZE-BASED RESOURCES ========== -->
    <!-- Padding -->
    <Thickness x:Key="CardPaddingSmall">10</Thickness>
    <Thickness x:Key="CardPaddingMedium">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">20</Thickness>

    <!-- Margin -->
    <Thickness x:Key="CardMarginSmall">8</Thickness>
    <Thickness x:Key="CardMarginMedium">0</Thickness>
    <Thickness x:Key="CardMarginLarge">0</Thickness>

    <!-- Title Font Sizes -->
    <x:Double x:Key="TitleFontSizeSmall">14</x:Double>
    <x:Double x:Key="TitleFontSizeMedium">16</x:Double>
    <x:Double x:Key="TitleFontSizeLarge">18</x:Double>

    <!-- Description Font Sizes -->
    <x:Double x:Key="DescriptionFontSizeSmall">11</x:Double>
    <x:Double x:Key="DescriptionFontSizeMedium">13</x:Double>
    <x:Double x:Key="DescriptionFontSizeLarge">15</x:Double>

    <!-- ========== BASE COMPONENT STYLES ========== -->
    <!-- Default styles are set to Medium size -->

    <!-- Card Style (HA 2026: CornerRadius=12, white card bg, no margin) -->
    <Style TargetType="Border" x:Key="CardBorderStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#FFFFFF', Dark='#2C2C2E'}" />
        <Setter Property="Padding" Value="{StaticResource CardPaddingMedium}" />
        <Setter Property="Margin" Value="{StaticResource CardMarginMedium}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=12}" />
        <Setter Property="Shadow">
            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08" />
        </Setter>
    </Style>

    <!-- Title Style -->
    <Style TargetType="Label" x:Key="ListItemTitleLabelStyle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light='#000000', Dark='#FFFFFF'}" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSizeMedium}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Description Style -->
    <Style TargetType="Label" x:Key="ListItemDescriptionLabelStyle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light='#9E9E9E', Dark='#8E8E93'}" />
        <Setter Property="FontSize" Value="{StaticResource DescriptionFontSizeMedium}" />
    </Style>

    <!-- Section Header Label Style -->
    <Style TargetType="Label" x:Key="SectionHeaderLabelStyle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light='#9E9E9E', Dark='#8E8E93'}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>

    <!-- Accent Link Label Style -->
    <Style TargetType="Label" x:Key="AccentLinkLabelStyle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light='#039BE5', Dark='#03A9F4'}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>
