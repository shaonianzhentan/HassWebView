<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Views.AlertExamplePage"
             Title="Alert 组件示例"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            
            <Label Text="Alert 警告提示组件" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
            
            <Label Text="支持四种类型：Warning、Error、Success、Info" FontSize="14" TextColor="#86868B" />
            
            <component:SectionHeader Title="Warning 警告" />
            <component:Alert Title="警告" Message="这是一条警告信息，请注意查看。" Type="Warning" />
            
            <component:SectionHeader Title="Error 错误" />
            <component:Alert Title="错误" Message="操作失败，请重试。" Type="Error" />
            
            <component:SectionHeader Title="Success 成功" />
            <component:Alert Title="成功" Message="操作成功完成！" Type="Success" />
            
            <component:SectionHeader Title="Info 信息" />
            <component:Alert Title="信息" Message="这是一条提示信息。" Type="Info" />
            
            <BoxView HeightRequest="40" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>