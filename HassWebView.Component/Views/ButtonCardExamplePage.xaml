<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Views.ButtonCardExamplePage"
             Title="ButtonCard 组件示例"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="ButtonCard 按钮卡片组件" FontSize="24" FontAttributes="Bold" />
            <Label Text="Home Assistant 风格的按钮卡片" FontSize="14" TextColor="#86868B" />
            
            <!-- 只使用 ButtonCard 组件 -->
            <component:ButtonCard Icon="🔴" Title="客厅灯" State="开启" />
            <component:ButtonCard Icon="🔵" Title="卧室灯" State="关闭" />
            <component:ButtonCard Icon="🟢" Title="厨房灯" State="开启" />
            <component:ButtonCard Icon="🔥" Title="热水器" State="加热中" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>