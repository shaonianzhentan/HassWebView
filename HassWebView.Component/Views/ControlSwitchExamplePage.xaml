<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Views.ControlSwitchExamplePage"
             Title="ControlSwitch 组件示例"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            
            <Label Text="ControlSwitch 开关组件" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
            
            <Label Text="支持开启、关闭、禁用状态" FontSize="14" TextColor="#86868B" />
            
            <component:SectionHeader Title="不同状态" />
            <VerticalStackLayout Spacing="12">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <component:ControlSwitch x:Name="Switch1" />
                    <Label Text="默认状态" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <component:ControlSwitch x:Name="Switch2" IsToggled="True" />
                    <Label Text="已开启" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <component:ControlSwitch x:Name="Switch3" IsToggled="False" />
                    <Label Text="已关闭" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <component:ControlSwitch Disabled="True" />
                    <Label Text="禁用状态" TextColor="#86868B" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <component:ControlSwitch IsToggled="True" Disabled="True" />
                    <Label Text="禁用并开启" TextColor="#86868B" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            
            <BoxView HeightRequest="40" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>