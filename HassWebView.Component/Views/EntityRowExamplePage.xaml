<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Views.EntityRowExamplePage"
             Title="EntityRow 组件示例"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="EntityRow 实体行组件" FontSize="24" FontAttributes="Bold" />
            <Label Text="用于显示 Home Assistant 实体信息的行组件" FontSize="14" TextColor="#86868B" />
            
            <!-- 只使用 EntityRow 组件 -->
            <component:EntityRow Name="客厅灯" Icon="💡" State="on" StateColor="#FCD34D" />
            <component:EntityRow Name="卧室灯" Icon="💡" State="off" StateColor="#9CA3AF" />
            <component:EntityRow Name="室内温度" Icon="🌡️" State="23.5°C" StateColor="#3B82F6" />
            <component:EntityRow Name="空调" Icon="❄️" State="制冷" StateColor="#3B82F6" />
            <component:EntityRow Name="加湿器" Icon="💧" State="开启" StateColor="#10B981" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>