<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Views.GaugeExamplePage"
             Title="Gauge 组件示例"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            
            <Label Text="Gauge 仪表盘组件" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
            
            <Label Text="Home Assistant 风格的环形仪表盘，支持标签、数值、单位" FontSize="14" TextColor="#86868B" />
            
            <component:SectionHeader Title="不同数值（颜色变化）" />
            <HorizontalStackLayout Spacing="24" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="25" Unit="%" Label="湿度" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="50" Unit="%" Label="亮度" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="75" Unit="%" Label="电量" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="95" Unit="%" Label="温度" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            
            <component:SectionHeader Title="不同单位" />
            <HorizontalStackLayout Spacing="24" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="23" Unit="°C" Label="温度" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="65" Unit="%" Label="湿度" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <component:Gauge Value="80" Unit="km/h" Label="速度" WidthRequest="120" HeightRequest="120" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            
            <BoxView HeightRequest="40" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>