<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.Views.ButtonGridExamplePage"
             Title="ButtonGrid 组件示例"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="ButtonGrid 按钮网格组件" FontSize="24" FontAttributes="Bold" />
            <Label Text="用于显示按钮网格布局" FontSize="14" TextColor="#86868B" />
            
            <!-- 只使用 ButtonGrid 组件 -->
            <component:ButtonGrid>
                <component:ButtonCard Icon="🔴" Title="客厅灯" State="开启" />
                <component:ButtonCard Icon="🔵" Title="卧室灯" State="关闭" />
                <component:ButtonCard Icon="🟢" Title="厨房灯" State="开启" />
                <component:ButtonCard Icon="🟡" Title="书房灯" State="关闭" />
            </component:ButtonGrid>
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>