<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.Component.MainPage"
             Title="Home Assistant Components"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackgroundColor}, Dark={StaticResource DarkBackgroundColor}}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            
            <!-- Header with Size and Theme Selectors -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Label x:Name="HeaderLabel" Text="🏠 组件演示" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
                <component:SizeSelector Grid.Column="1" />
                <component:ThemeSelector Grid.Column="2" />
            </Grid>
            
            <Label Text="使用左侧侧边栏导航查看各组件示例" FontSize="14" TextColor="#86868B" />
            
            <component:SectionHeader Title="主题切换" />
            <Label Text="点击右上角主题按钮切换亮色/暗色/系统主题" FontSize="14" TextColor="#86868B" />
            
            <component:SectionHeader Title="尺寸切换" />
            <Label Text="点击右上角尺寸按钮切换手机/平板/电视尺寸" FontSize="14" TextColor="#86868B" />
            
            <!-- Spacing -->
            <BoxView HeightRequest="40" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>