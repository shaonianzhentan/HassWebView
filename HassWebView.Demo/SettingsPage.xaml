<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components;assembly=HassWebView.Component"
             x:Class="HassWebView.Demo.SettingsPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">

            <!-- 外观设置 -->
            <component:SettingsGroup Title="外观设置">
                <component:InfoRow Icon="🎨" 
                                   Label="主题模式" 
                                   Value="{Binding CurrentThemeText}" />
            </component:SettingsGroup>
            
            <component:SettingsGroup Title="主题选择">
                <component:ThemeSelector />
            </component:SettingsGroup>

            <component:SettingsGroup Title="界面尺寸">
                <component:InfoRow Icon="📐" 
                                   Label="当前尺寸" 
                                   Value="{Binding CurrentSizeText}" />
            </component:SettingsGroup>
            
            <component:SettingsGroup Title="尺寸选择">
                <component:SizeSelector />
            </component:SettingsGroup>

            <!-- 连接信息 -->
            <component:SettingsGroup Title="连接信息">
                <component:InfoRow Icon="🏠" 
                                   Label="实例地址" 
                                   Value="{Binding HassUrl}" />
                <component:InfoRow Icon="📡" 
                                   Label="推送 URL" 
                                   Value="{Binding PushUrl}" />
            </component:SettingsGroup>

            <!-- 设备信息 -->
            <component:SettingsGroup Title="设备信息">
                <component:InfoRow Icon="📱" 
                                   Label="平台" 
                                   Value="{Binding Platform}" />
                <component:InfoRow Icon="💻" 
                                   Label="设备" 
                                   Value="{Binding DeviceName}" />
                <component:InfoRow Icon="🏭" 
                                   Label="制造商" 
                                   Value="{Binding Manufacturer}" />
                <component:InfoRow Icon="⚙️" 
                                   Label="系统版本" 
                                   Value="{Binding OsVersion}" />
            </component:SettingsGroup>

            <!-- 关于 -->
            <component:SettingsGroup Title="关于">
                <component:InfoRow Icon="ℹ️" 
                                   Label="应用版本" 
                                   Value="{Binding AppVersion}" />
                <component:InfoRow Icon="🔧" 
                                   Label="运行时" 
                                   Value=".NET MAUI" />
            </component:SettingsGroup>

            <!-- 开源许可 -->
            <component:SettingsGroup Title="开源许可">
                <component:InfoRow Icon="📄" 
                                   Label=".NET MAUI" 
                                   Value="MIT" />
                <component:InfoRow Icon="📄" 
                                   Label="YamlDotNet" 
                                   Value="MIT" />
                <component:InfoRow Icon="📄" 
                                   Label="Home Assistant" 
                                   Value="Apache 2.0" />
            </component:SettingsGroup>

            <BoxView HeightRequest="40" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>