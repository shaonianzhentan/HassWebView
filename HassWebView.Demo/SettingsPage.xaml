<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.Demo.SettingsPage"
             xmlns:hass="clr-namespace:HassWebView.Component;assembly=HassWebView.Component"
             Title="设置"
             BackgroundColor="{AppThemeBinding Light='#F2F2F7', Dark='#000000}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- 关于 -->
            <hass:SectionHeader Title="关于" />

            <hass:DetailCard Title="HassWebView"
                             Subtitle="Home Assistant 智能控制中心"
                             State="on">
                <hass:InfoRow Title="版本" Value="{Binding AppVersion}" />
                <hass:InfoRow Title="运行时" Value=".NET MAUI" HideBottomLine="True" />
            </hass:DetailCard>

            <!-- 连接信息 -->
            <hass:SectionHeader Title="连接信息" />

            <hass:DetailCard Title="Home Assistant">
                <hass:InfoRow Title="实例地址" Value="{Binding HassUrl}" />
                <hass:InfoRow Title="推送 URL" Value="{Binding PushUrl}" HideBottomLine="True" />
            </hass:DetailCard>

            <!-- 设备信息 -->
            <hass:SectionHeader Title="设备信息" />

            <hass:DetailCard Title="当前设备">
                <hass:InfoRow Title="平台" Value="{Binding Platform}" />
                <hass:InfoRow Title="设备" Value="{Binding DeviceName}" />
                <hass:InfoRow Title="制造商" Value="{Binding Manufacturer}" />
                <hass:InfoRow Title="系统版本" Value="{Binding OsVersion}" HideBottomLine="True" />
            </hass:DetailCard>

            <!-- 开源许可 -->
            <hass:SectionHeader Title="开源许可" />

            <hass:DetailCard Title="第三方组件">
                <hass:InfoRow Title=".NET MAUI" Value="MIT" />
                <hass:InfoRow Title="YamlDotNet" Value="MIT" />
                <hass:InfoRow Title="Home Assistant" Value="Apache 2.0" HideBottomLine="True" />
            </hass:DetailCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
