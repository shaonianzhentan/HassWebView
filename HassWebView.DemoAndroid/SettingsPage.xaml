<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.DemoAndroid.SettingsPage"
             Title="设置"
             BackgroundColor="{AppThemeBinding Light='#F5F5F7', Dark='#1C1C1E'}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ═══════════════════════════════════════ -->
            <!-- 分组 1: GPS 定位                        -->
            <!-- ═══════════════════════════════════════ -->
            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="GPS 定位" FontSize="16" FontAttributes="Bold" />

                    <!-- 权限状态行 -->
                    <HorizontalStackLayout>
                        <Label Text="定位权限:" />
                        <Label Text="{Binding GpsPermissionStatus}" Margin="8,0,0,0" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenSystemPermissionTapped" CommandParameter="Location" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!-- 前往授权按钮 -->
                    <Button x:Name="GpsAuthButton" Text="前往授权" BackgroundColor="#FF9800" TextColor="White" CornerRadius="10" HeightRequest="44" Clicked="OnGpsAuthClicked" IsVisible="False" />

                    <!-- 系统权限设置按钮 -->
                    <Button x:Name="GpsSettingsButton" Text="系统权限设置" BackgroundColor="#EBEBEB" TextColor="Black" CornerRadius="10" HeightRequest="44" Clicked="OnOpenGpsSystemSettingsClicked" IsVisible="False" />

                    <!-- 上报间隔 -->
                    <VerticalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="上报间隔:" />
                            <Label x:Name="GpsIntervalLabel" Text="30 秒" Margin="8,0,0,0" />
                        </HorizontalStackLayout>
                        <Slider x:Name="GpsIntervalSlider" Minimum="5" Maximum="300" ValueChanged="OnGpsIntervalChanged" />
                    </VerticalStackLayout>

                    <!-- WiFi 时停止定位 -->
                    <HorizontalStackLayout>
                        <Label Text="WiFi 连接时停止定位" VerticalOptions="Center" />
                        <Switch x:Name="GpsWifiSwitch" Toggled="OnGpsWifiSwitchToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- 分组 2: 通知转发                        -->
            <!-- ═══════════════════════════════════════ -->
            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="通知转发" FontSize="16" FontAttributes="Bold" />

                    <!-- 转发应用列表 -->
                    <HorizontalStackLayout>
                        <Label Text="转发应用:" />
                        <Label Text="{Binding NotifyAppCount}" Margin="8,0,0,0" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotifyAppsTapped" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!-- 通知监听权限 -->
                    <HorizontalStackLayout>
                        <Label Text="通知监听权限:" />
                        <Label Text="{Binding NotifyPermissionStatus}" Margin="8,0,0,0" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenSystemPermissionTapped" CommandParameter="Notification" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!-- 前往通知访问设置 -->
                    <Button Text="前往通知访问设置" BackgroundColor="#EBEBEB" TextColor="Black" CornerRadius="10" HeightRequest="44" Clicked="OnOpenNotifyAccessSettingsClicked" />

                    <!-- 屏幕事件推送 -->
                    <HorizontalStackLayout>
                        <Label Text="屏幕事件推送" VerticalOptions="Center" />
                        <Switch x:Name="ScreenEventSwitch" Toggled="OnScreenEventSwitchToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- 分组 3: 短信转发                        -->
            <!-- ═══════════════════════════════════════ -->
            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="短信转发" FontSize="16" FontAttributes="Bold" />

                    <!-- 短信权限状态 -->
                    <HorizontalStackLayout>
                        <Label Text="短信读取权限:" />
                        <Label Text="{Binding SmsPermissionStatus}" Margin="8,0,0,0" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenSystemPermissionTapped" CommandParameter="Sms" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!-- 前往授权 -->
                    <Button x:Name="SmsAuthButton" Text="前往授权" BackgroundColor="#FF9800" TextColor="White" CornerRadius="10" HeightRequest="44" Clicked="OnSmsAuthClicked" IsVisible="False" />

                    <!-- 启用短信转发 -->
                    <HorizontalStackLayout>
                        <Label Text="启用短信转发" VerticalOptions="Center" />
                        <Switch x:Name="SmsForwardSwitch" Toggled="OnSmsForwardSwitchToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>

                    <!-- 转发目标 -->
                    <HorizontalStackLayout>
                        <Label Text="转发目标:" />
                        <Label Text="Home Assistant Webhook" Margin="8,0,0,0" TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- 分组 4: 桌面小组件                      -->
            <!-- ═══════════════════════════════════════ -->
            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="桌面小组件" FontSize="16" FontAttributes="Bold" />

                    <!-- 已添加数量 -->
                    <HorizontalStackLayout>
                        <Label Text="已添加小组件:" />
                        <Label Text="{Binding WidgetCount}" Margin="8,0,0,0" />
                    </HorizontalStackLayout>

                    <!-- 管理按钮 -->
                    <Button Text="管理小组件" BackgroundColor="#039BE5" TextColor="White" CornerRadius="10" HeightRequest="44" Clicked="OnManageWidgetsClicked" />

                    <!-- 自动刷新 -->
                    <HorizontalStackLayout>
                        <Label Text="小组件自动刷新" VerticalOptions="Center" />
                        <Switch x:Name="WidgetAutoRefreshSwitch" Toggled="OnWidgetAutoRefreshToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>

                    <!-- 刷新间隔 -->
                    <VerticalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="刷新间隔:" />
                            <Label x:Name="WidgetRefreshIntervalLabel" Text="15 分钟" Margin="8,0,0,0" />
                        </HorizontalStackLayout>
                        <Slider x:Name="WidgetRefreshIntervalSlider" Minimum="5" Maximum="60" ValueChanged="OnWidgetRefreshIntervalChanged" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- 分组 5: 功能开关                        -->
            <!-- ═══════════════════════════════════════ -->
            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="功能开关" FontSize="16" FontAttributes="Bold" />

                    <!-- 屏幕事件推送 -->
                    <HorizontalStackLayout>
                        <Label Text="屏幕事件推送" VerticalOptions="Center" />
                        <Switch x:Name="ScreenEventGlobalSwitch" Toggled="OnScreenEventGlobalToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>

                    <!-- WiFi 连接停止定位 -->
                    <HorizontalStackLayout>
                        <Label Text="WiFi 连接停止定位" VerticalOptions="Center" />
                        <Switch x:Name="WifiStopGpsSwitch" Toggled="OnWifiStopGpsToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>

                    <!-- 按键控制 -->
                    <HorizontalStackLayout>
                        <Label Text="按键控制" VerticalOptions="Center" />
                        <Switch x:Name="KeyControlSwitch" Toggled="OnKeyControlToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>

                    <!-- 局域网自动切换 -->
                    <HorizontalStackLayout>
                        <Label Text="局域网自动切换" VerticalOptions="Center" />
                        <Switch x:Name="LanAutoSwitchCard" Toggled="OnLanAutoSwitchToggled" HorizontalOptions="End" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>