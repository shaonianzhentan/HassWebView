<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.DemoAndroid.MainPage"
             BackgroundColor="{AppThemeBinding Light='#F5F5F7', Dark='#1C1C1E'}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ===== 快捷操作磁贴 ===== -->
            <Label Text="快捷操作" FontSize="16" FontAttributes="Bold" Margin="0,0,0,8" />
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="💡 客厅灯" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="12" />
                <Button Grid.Row="0" Grid.Column="1" Text="🔒 门锁" BackgroundColor="#2196F3" TextColor="White" CornerRadius="12" />
                <Button Grid.Row="0" Grid.Column="2" Text="🌡️ 空调" BackgroundColor="#FF9800" TextColor="White" CornerRadius="12" />
                <Button Grid.Row="1" Grid.Column="0" Text="📷 摄像头" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="12" />
                <Button Grid.Row="1" Grid.Column="1" Text="🚗 车库门" BackgroundColor="#00BCD4" TextColor="White" CornerRadius="12" />
                <Button Grid.Row="1" Grid.Column="2" Text="🔔 门铃" BackgroundColor="#E91E63" TextColor="White" CornerRadius="12" />
            </Grid>

            <!-- ===== 设备列表 ===== -->
            <Label Text="我的设备" FontSize="16" FontAttributes="Bold" Margin="0,16,0,8" />
            <VerticalStackLayout Spacing="4">
                <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout>
                        <Label Text="💡" FontSize="18" Margin="0,0,12,0" />
                        <VerticalStackLayout>
                            <Label Text="客厅灯" FontAttributes="Bold" />
                            <Label Text="飞利浦 Hue - 开启" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout>
                        <Label Text="🌡️" FontSize="18" Margin="0,0,12,0" />
                        <VerticalStackLayout>
                            <Label Text="温度传感器" FontAttributes="Bold" />
                            <Label Text="客厅 - 23°C" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                    <HorizontalStackLayout>
                        <Label Text="💧" FontSize="18" Margin="0,0,12,0" />
                        <VerticalStackLayout>
                            <Label Text="湿度传感器" FontAttributes="Bold" />
                            <Label Text="卧室 - 65%" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ===== 调节 ===== -->
            <Label Text="调节" FontSize="16" FontAttributes="Bold" Margin="0,16,0,8" />

            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="客厅亮度" FontAttributes="Bold" />
                    <Slider Value="75" Minimum="0" Maximum="100" />
                    <Label Text="75%" HorizontalOptions="End" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="音量" FontAttributes="Bold" />
                    <Slider Value="40" Minimum="0" Maximum="100" />
                    <Label Text="40%" HorizontalOptions="End" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== 设备详情 ===== -->
            <Label Text="设备详情" FontSize="16" FontAttributes="Bold" Margin="0,16,0,8" />

            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="空调" FontSize="18" FontAttributes="Bold" />
                    <Label Text="格力 KFR-35 - 开启" FontSize="12" TextColor="Gray" />
                    <Border StrokeThickness="0" BackgroundColor="#F5F5F5" Padding="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="目标温度" FontSize="12" />
                            <Slider Value="26" Minimum="16" Maximum="30" />
                        </VerticalStackLayout>
                    </Border>
                    <HorizontalStackLayout>
                        <Label Text="当前温度:" FontSize="12" TextColor="Gray" />
                        <Label Text="28°C" FontSize="12" Margin="8,0,0,0" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="模式:" FontSize="12" TextColor="Gray" />
                        <Label Text="制冷" FontSize="12" Margin="8,0,0,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== 应用设置 ===== -->
            <Label Text="通知设置" FontSize="16" FontAttributes="Bold" Margin="0,16,0,8" />

            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout>
                        <Label Text="启用推送通知" FlexLayout.Grow="1" />
                        <Switch IsToggled="True" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="通知渠道" FlexLayout.Grow="1" />
                        <Label Text="Home Assistant" TextColor="Gray" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="震动反馈" FlexLayout.Grow="1" />
                        <Switch />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== 系统信息 ===== -->
            <Label Text="系统信息" FontSize="16" FontAttributes="Bold" Margin="0,16,0,8" />

            <Border StrokeThickness="0" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout>
                        <Label Text="应用版本" FlexLayout.Grow="1" TextColor="Gray" />
                        <Label Text="1.0.0" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="HA 服务器" FlexLayout.Grow="1" TextColor="Gray" />
                        <Label Text="homeassistant.local" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="连接状态" FlexLayout.Grow="1" TextColor="Gray" />
                        <Label Text="已连接" TextColor="#4CAF50" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>