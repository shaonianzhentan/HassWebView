<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:hass="clr-namespace:HassWebView.Component;assembly=HassWebView.Component"
             x:Class="HassWebView.DemoAndroid.MainPage"
             BackgroundColor="{AppThemeBinding Light='#F5F5F7', Dark='#1C1C1E'}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ===== ButtonGrid: 快捷操作磁贴 ===== -->
            <hass:ButtonGrid Title="快捷操作" Columns="3">
                <hass:ButtonCard IconText="💡" Title="客厅灯" State="开启" IsActive="True" ShowBadge="True" />
                <hass:ButtonCard IconText="🔒" Title="门锁" State="已锁定" />
                <hass:ButtonCard IconText="🌡️" Title="空调" State="关闭" />
                <hass:ButtonCard IconText="📷" Title="摄像头" State="在线" IsActive="True" />
                <hass:ButtonCard IconText="🚗" Title="车库门" State="关闭" />
                <hass:ButtonCard IconText="🔔" Title="门铃" State="正常" />
            </hass:ButtonGrid>

            <!-- ===== EntityListGroup: 设备列表 ===== -->
            <hass:EntityListGroup Title="我的设备" Action="查看全部"
                                  ActionTapped="OnViewAllTapped">
                <hass:EntityRow IconText="💡" Title="客厅灯" Description="飞利浦 Hue" State="on" IsActive="True" />
                <hass:EntityRow IconText="🌡️" Title="温度传感器" Description="客厅" State="23°C" />
                <hass:EntityRow IconText="💧" Title="湿度传感器" Description="卧室" State="65%" />
                <hass:EntityRow IconText="📡" Title="路由器" Description="TP-Link" State="unavailable" />
            </hass:EntityListGroup>

            <!-- ===== SliderCard: 亮度 / 音量调节 ===== -->
            <hass:SectionHeader Title="调节" />

            <hass:SliderCard Title="客厅亮度"
                             Value="75"
                             Unit="%"
                             Step="5"
                             ValueChanged="OnBrightnessChanged" />

            <hass:SliderCard Title="音量"
                             Value="40"
                             Min="0"
                             Max="100"
                             Unit="%"
                             Step="1" />

            <!-- ===== DetailCard: 设备详情 ===== -->
            <hass:SectionHeader Title="详情" />

            <hass:DetailCard Title="空调" Subtitle="格力 KFR-35" State="on">
                <hass:DetailCard.ActionContent>
                    <hass:SliderCard Title="目标温度"
                                     Value="26"
                                     Min="16"
                                     Max="30"
                                     Step="0.5"
                                     Unit="°C" />
                </hass:DetailCard.ActionContent>
                <hass:InfoRow Title="当前温度" Value="28°C" />
                <hass:InfoRow Title="模式" Value="制冷" />
                <hass:InfoRow Title="风速" Value="自动" />
                <hass:InfoRow Title="上次触发" Value="10 分钟前" />
            </hass:DetailCard>

            <!-- ===== SettingsGroup: 应用设置 ===== -->
            <hass:SettingsGroup Title="通知设置" Footer="修改后即时生效">
                <hass:ControlSwitch Title="启用推送通知" IsToggled="True" />
                <hass:InfoRow Title="通知渠道" Value="Home Assistant" />
                <hass:ControlSwitch Title="震动反馈" />
            </hass:SettingsGroup>

            <hass:SettingsGroup Title="系统信息">
                <hass:InfoRow Title="应用版本" Value="1.0.0" />
                <hass:InfoRow Title="HA 服务器" Value="homeassistant.local" />
                <hass:InfoRow Title="连接状态" Value="已连接" />
                <hass:InfoRow Title="最后同步" Value="刚刚" />
            </hass:SettingsGroup>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
