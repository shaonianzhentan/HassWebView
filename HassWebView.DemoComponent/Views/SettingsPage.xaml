<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HassWebView.DemoComponent.Views.SettingsPage"
             Title="设置"
             BackgroundColor="#F2F2F7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            <Label Text="设置"
                   FontAttributes="Bold"
                   FontSize="28"
                   TextColor="#1D1D1F" />

            <Label Text="主题切换：" FontAttributes="Bold" TextColor="#1D1D1F" />
            <Label Text="使用侧边栏导航到 ThemeSelector 页面进行主题切换" FontSize="14" TextColor="#636366" />

            <BoxView HeightRequest="20" />

            <Label Text="尺寸切换：" FontAttributes="Bold" TextColor="#1D1D1F" />
            <Label Text="使用侧边栏导航到 SizeSelector 页面进行尺寸切换" FontSize="14" TextColor="#636366" />

            <BoxView HeightRequest="40" />

            <Label Text="当前主题：" FontSize="14" TextColor="#636366" />
            <Label x:Name="CurrentThemeLabel" FontSize="16" TextColor="#1D1D1F" />

            <Label Text="当前尺寸：" FontSize="14" TextColor="#636366" />
            <Label x:Name="CurrentSizeLabel" FontSize="16" TextColor="#1D1D1F" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
