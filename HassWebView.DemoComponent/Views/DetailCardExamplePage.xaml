<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.DetailCardExamplePage"
             Title="DetailCard 组件示例"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="DetailCard 详情卡片组件" FontSize="24" FontAttributes="Bold" />
            <Label Text="用于展示实体详细信息的卡片" FontSize="14" TextColor="#86868B" />
            
            <!-- 只使用 DetailCard 组件 -->
            <component:DetailCard Title="室内温度" State="23.5°C" Subtitle="客厅" />
            <component:DetailCard Title="室内湿度" State="65%" Subtitle="卧室" />
            <component:DetailCard Title="电池电量" State="85%" Subtitle="智能门锁" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
