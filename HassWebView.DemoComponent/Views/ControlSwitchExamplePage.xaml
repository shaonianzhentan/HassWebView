<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.ControlSwitchExamplePage"
             Title="ControlSwitch 组件示例"
             BackgroundColor="#F2F2F7">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="ControlSwitch 开关组件" FontSize="24" FontAttributes="Bold" TextColor="#1D1D1F" />
            <Label Text="用于切换布尔状态的开关控件" FontSize="14" TextColor="#86868B" />
            
            <!-- 只使用 ControlSwitch 组件 -->
            <component:ControlSwitch IsToggled="False" />
            <component:ControlSwitch IsToggled="True" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
