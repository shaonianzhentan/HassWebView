<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.DialogExamplePage"
             Title="Dialog 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="用于显示弹窗对话框" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <Button Text="显示对话框" Clicked="OnShowDialogClicked" />
            <component:Dialog x:Name="ExampleDialog"
                              Title="提示"
                              Message="这是一个对话框示例"
                              Confirmed="OnDialogConfirmClicked" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>