<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.DialogExamplePage"
             Title="Dialog 组件示例"
             BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="Dialog 对话框组件" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#FFFFFF}" />
            <Label Text="用于显示弹窗对话框" FontSize="14" TextColor="{AppThemeBinding Light=#86868B, Dark=#8E8E93}" />
            
            <!-- 只使用 Dialog 组件 -->
            <Button Text="显示对话框" Clicked="OnShowDialogClicked" />
            <component:Dialog x:Name="ExampleDialog"
                              Title="提示"
                              Message="这是一个对话框示例"
                              Confirmed="OnDialogConfirmClicked" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>