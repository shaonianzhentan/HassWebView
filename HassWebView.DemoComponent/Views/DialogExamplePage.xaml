<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.DialogExamplePage"
             Title="Dialog 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="用于显示弹窗对话框" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            
            <!-- 基础用法 -->
            <Button Text="显示对话框" Clicked="OnShowDialogClicked" />
            <component:Dialog x:Name="ExampleDialog"
                              Title="提示"
                              Confirmed="OnDialogConfirmClicked">
                <Label Text="这是一个对话框示例" />
            </component:Dialog>
            
            <!-- 无标题对话框 -->
            <Button Text="显示无标题对话框" Clicked="OnShowDialogNoTitleClicked" />
            <component:Dialog x:Name="NoTitleDialog"
                              CancelText="取消"
                              ConfirmText="确定"
                              Confirmed="OnDialogConfirmClicked">
                <VerticalStackLayout Spacing="8">
                    <Label Text="确定要删除这个项目吗？" TextColor="{DynamicResource ErrorColor}" />
                    <Label Text="删除后无法恢复，请谨慎操作。" TextColor="{DynamicResource SecondaryTextColor}" />
                </VerticalStackLayout>
            </component:Dialog>
            
            <!-- 自定义内容对话框 -->
            <Button Text="显示自定义内容对话框" Clicked="OnShowCustomDialogClicked" />
            <component:Dialog x:Name="CustomDialog"
                              Title="选择语言"
                              CancelText="取消"
                              ConfirmText="确定"
                              Confirmed="OnDialogConfirmClicked">
                <VerticalStackLayout Spacing="8">
                    <RadioButton GroupName="Lang" IsChecked="True">
                        <RadioButton.Content>
                            <Label Text="中文" />
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="Lang">
                        <RadioButton.Content>
                            <Label Text="English" />
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="Lang">
                        <RadioButton.Content>
                            <Label Text="日本語" />
                        </RadioButton.Content>
                    </RadioButton>
                </VerticalStackLayout>
            </component:Dialog>
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Dialog Title="手机对话框"
                              Size="{x:Static models:ComponentSize.Phone}">
                <Label Text="这是手机尺寸的对话框" />
            </component:Dialog>
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Dialog Title="平板对话框"
                              Size="{x:Static models:ComponentSize.Tablet}">
                <Label Text="这是平板尺寸的对话框" />
            </component:Dialog>
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Dialog Title="TV对话框"
                              Size="{x:Static models:ComponentSize.TV}">
                <Label Text="这是TV尺寸的对话框" />
            </component:Dialog>
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>