<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.InputExamplePage"
             Title="Input 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="用于用户输入文本" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Input Label="用户名" Placeholder="请输入用户名" />
            <component:Input Label="密码" Placeholder="请输入密码" IsPassword="True" />
            <component:Input Label="邮箱" Placeholder="请输入邮箱地址" />
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Input Label="手机输入" Placeholder="手机尺寸" Size="{x:Static models:ComponentSize.Phone}" />
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Input Label="平板输入" Placeholder="平板尺寸" Size="{x:Static models:ComponentSize.Tablet}" />
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Input Label="TV输入" Placeholder="TV尺寸" Size="{x:Static models:ComponentSize.TV}" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
