<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.SpinnerExamplePage"
             Title="Spinner 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="Spinner 加载指示器组件" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
            <Label Text="用于显示加载状态" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            
            <!-- 只使用 Spinner 组件 -->
            <component:Spinner IsRunning="True" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
