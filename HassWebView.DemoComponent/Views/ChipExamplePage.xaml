<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.ChipExamplePage"
             Title="Chip 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="用于显示可选择或可关闭的标签" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Chip Text="标签示例" ShowIcon="True" IconText="🏷️" />
            <component:Chip Text="可关闭标签" Dismissible="True" />
            <component:Chip Text="简单标签" />
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Chip Text="手机标签" ShowIcon="True" IconText="🏷️" Size="{x:Static models:ComponentSize.Phone}" />
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Chip Text="平板标签" ShowIcon="True" IconText="🏷️" Size="{x:Static models:ComponentSize.Tablet}" />
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Chip Text="TV标签" ShowIcon="True" IconText="🏷️" Size="{x:Static models:ComponentSize.TV}" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
