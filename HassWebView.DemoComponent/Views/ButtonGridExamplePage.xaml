<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.ButtonGridExamplePage"
             Title="ButtonGrid 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="用于显示设备控制网格" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:ButtonGrid>
                <component:ButtonCard Icon="💡" Title="客厅灯" State="on" />
                <component:ButtonCard Icon="❄️" Title="空调" State="cooling" />
                <component:ButtonCard Icon="📺" Title="电视" State="off" />
                <component:ButtonCard Icon="🎵" Title="音响" State="playing" />
            </component:ButtonGrid>
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
