<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.ButtonCardExamplePage"
             Title="ButtonCard 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="用于显示设备控制卡片" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:ButtonCard Icon="💡" Title="客厅灯" State="on" />
            <component:ButtonCard Icon="❄️" Title="空调" State="cooling" />
            <component:ButtonCard Icon="📺" Title="电视" State="off" ShowBadge="True" />
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:ButtonCard Icon="💡" Title="客厅灯" State="on" Size="{x:Static models:ComponentSize.Phone}" />
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:ButtonCard Icon="❄️" Title="空调" State="cooling" Size="{x:Static models:ComponentSize.Tablet}" />
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:ButtonCard Icon="📺" Title="电视" State="off" Size="{x:Static models:ComponentSize.TV}" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
