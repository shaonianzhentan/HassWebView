<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.SettingsGroupExamplePage"
             Title="SettingsGroup 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="用于分组显示设置项" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SettingsGroup Title="常规设置">
                <component:InfoRow Icon="🔔" Label="通知" Value="开启" />
                <component:InfoRow Icon="🔒" Label="隐私" Value="已保护" />
                <component:InfoRow Icon="🌙" Label="深色模式" Value="跟随系统" />
            </component:SettingsGroup>
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SettingsGroup Title="手机设置" Size="{x:Static models:ComponentSize.Phone}">
                <component:InfoRow Icon="🔔" Label="通知" Value="开启" />
                <component:InfoRow Icon="🔒" Label="隐私" Value="已保护" />
            </component:SettingsGroup>
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SettingsGroup Title="平板设置" Size="{x:Static models:ComponentSize.Tablet}">
                <component:InfoRow Icon="🔔" Label="通知" Value="开启" />
                <component:InfoRow Icon="🔒" Label="隐私" Value="已保护" />
            </component:SettingsGroup>
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SettingsGroup Title="TV设置" Size="{x:Static models:ComponentSize.TV}">
                <component:InfoRow Icon="🔔" Label="通知" Value="开启" />
                <component:InfoRow Icon="🔒" Label="隐私" Value="已保护" />
            </component:SettingsGroup>
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>