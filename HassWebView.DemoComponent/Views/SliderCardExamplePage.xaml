<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.SliderCardExamplePage"
             Title="SliderCard 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="带标签的滑块组件，用于调节数值" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SliderCard Title="亮度调节" Value="75" Min="0" Max="100" Unit="%" />
            <component:SliderCard Title="温度调节" Value="24" Min="16" Max="30" Unit="°C" />
            <component:SliderCard Title="音量调节" Value="60" Min="0" Max="100" Unit="%" />
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SliderCard Title="手机亮度" Value="75" Min="0" Max="100" Unit="%" Size="{x:Static models:ComponentSize.Phone}" />
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SliderCard Title="平板亮度" Value="75" Min="0" Max="100" Unit="%" Size="{x:Static models:ComponentSize.Tablet}" />
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:SliderCard Title="TV亮度" Value="75" Min="0" Max="100" Unit="%" Size="{x:Static models:ComponentSize.TV}" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>