<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.EntityRowExamplePage"
             Title="EntityRow 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="用于显示 Home Assistant 实体信息的行组件" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:EntityRow Title="客厅灯" IconText="💡" State="on" StateColor="#FCD34D" />
            <component:EntityRow Title="卧室灯" IconText="💡" State="off" StateColor="#9CA3AF" />
            <component:EntityRow Title="室内温度" IconText="🌡️" State="23.5°C" StateColor="#3B82F6" />
            <component:EntityRow Title="空调" IconText="❄️" State="制冷" StateColor="#3B82F6" />
            <component:EntityRow Title="加湿器" IconText="💧" State="开启" StateColor="#10B981" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>