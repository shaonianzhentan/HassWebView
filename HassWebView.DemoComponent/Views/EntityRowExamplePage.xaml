<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             xmlns:models="clr-namespace:HassWebView.Component.Models"
             x:Class="HassWebView.DemoComponent.Views.EntityRowExamplePage"
             Title="EntityRow 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="用于显示 Home Assistant 实体信息的行组件" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:EntityRow Title="客厅灯" IconText="💡" State="on" />
            <component:EntityRow Title="卧室灯" IconText="💡" State="off" />
            <component:EntityRow Title="室内温度" IconText="🌡️" State="23.5°C" />
            <component:EntityRow Title="空调" IconText="❄️" State="cooling" />
            <component:EntityRow Title="加湿器" IconText="💧" State="on" />
            
            <BoxView HeightRequest="40" />
            
            <!-- 尺寸展示区域 -->
            <Label Text="📱 手机尺寸（Phone）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:EntityRow Title="手机灯" IconText="💡" State="on" Size="{x:Static models:ComponentSize.Phone}" />
            
            <Label Text="📲 平板尺寸（Tablet）" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:EntityRow Title="平板灯" IconText="💡" State="on" Size="{x:Static models:ComponentSize.Tablet}" />
            
            <Label Text="📺 TV尺寸" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:EntityRow Title="TV灯" IconText="💡" State="on" Size="{x:Static models:ComponentSize.TV}" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>