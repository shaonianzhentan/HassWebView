<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:HassWebView.Component.Components"
             x:Class="HassWebView.DemoComponent.Views.AlertExamplePage"
             Title="Alert 组件示例"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="支持四种类型：Warning、Error、Success、Info" FontSize="14" TextColor="{DynamicResource TertiaryTextColor}" />
            <component:Alert Type="Warning" Title="警告" Message="这是一个警告提示信息" />
            <component:Alert Type="Error" Title="错误" Message="这是一个错误提示信息" />
            <component:Alert Type="Success" Title="成功" Message="操作成功完成" />
            <component:Alert Type="Info" Title="信息" Message="这是一条信息提示" />
            
            <BoxView HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
