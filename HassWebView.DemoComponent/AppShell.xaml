<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:HassWebView.DemoComponent"
       xmlns:views="clr-namespace:HassWebView.DemoComponent.Views"
       x:Class="HassWebView.DemoComponent.AppShell"
       Title="Home Assistant Components"
       FlyoutBehavior="Locked"
       FlyoutBackgroundColor="{DynamicResource FlyoutBackgroundColor}"
       BackgroundColor="{DynamicResource NavigationBarColor}"
       TitleColor="{DynamicResource PrimaryTextColor}">

    <Shell.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="FlyoutItemTemplate">
                <Grid Padding="12,8" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Label Grid.Column="0" 
                           Text="{Binding FlyoutIcon}" 
                           FontSize="20"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                    <Label Grid.Column="1" 
                           Text="{Binding Title}" 
                           FontSize="{DynamicResource ComponentTitleSizeSmall}"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           VerticalOptions="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Shell.Resources>

    <FlyoutItem Title="首页" Icon="🏠" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Alert" Icon="⚠️" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="AlertExamplePage" ContentTemplate="{DataTemplate views:AlertExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Chip" Icon="📌" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="ChipExamplePage" ContentTemplate="{DataTemplate views:ChipExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Input" Icon="✏️" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="InputExamplePage" ContentTemplate="{DataTemplate views:InputExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Switch" Icon="🔘" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="SwitchExamplePage" ContentTemplate="{DataTemplate views:SwitchExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Spinner" Icon="🔄" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="SpinnerExamplePage" ContentTemplate="{DataTemplate views:SpinnerExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ButtonCard" Icon="🔘" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="ButtonCardExamplePage" ContentTemplate="{DataTemplate views:ButtonCardExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ButtonGrid" Icon="🔲" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="ButtonGridExamplePage" ContentTemplate="{DataTemplate views:ButtonGridExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="DetailCard" Icon="📋" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="DetailCardExamplePage" ContentTemplate="{DataTemplate views:DetailCardExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="EntityRow" Icon="📝" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="EntityRowExamplePage" ContentTemplate="{DataTemplate views:EntityRowExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="EntityListGroup" Icon="📋" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="EntityListGroupExamplePage" ContentTemplate="{DataTemplate views:EntityListGroupExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="SliderCard" Icon="🎚️" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="SliderCardExamplePage" ContentTemplate="{DataTemplate views:SliderCardExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="StateBadge" Icon="🏷️" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="StateBadgeExamplePage" ContentTemplate="{DataTemplate views:StateBadgeExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ThemeSelector" Icon="🎨" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="ThemeSelectorExamplePage" ContentTemplate="{DataTemplate views:ThemeSelectorExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="SizeSelector" Icon="📐" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="SizeSelectorExamplePage" ContentTemplate="{DataTemplate views:SizeSelectorExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="SettingsGroup" Icon="⚙️" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="SettingsGroupExamplePage" ContentTemplate="{DataTemplate views:SettingsGroupExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="设置" Icon="🔧" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="关于" Icon="ℹ️" Shell.ItemTemplate="{StaticResource FlyoutItemTemplate}">
        <ShellContent Route="AboutPage" ContentTemplate="{DataTemplate views:AboutPage}" />
    </FlyoutItem>

</Shell>
