<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:HassWebView.DemoComponent"
       xmlns:views="clr-namespace:HassWebView.DemoComponent.Views"
       x:Class="HassWebView.DemoComponent.AppShell"
       Title="Home Assistant Components"
       FlyoutBehavior="Locked">
    
    <Shell.FlyoutHeader>
        <ContentView Padding="16" BackgroundColor="{DynamicResource PageBackgroundColor}">
            <Label Text="HA Components"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryTextColor}" />
        </ContentView>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="首页" Icon="🏠">
        <ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Alert" Icon="⚠️">
        <ShellContent Route="AlertExamplePage" ContentTemplate="{DataTemplate views:AlertExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Chip" Icon="📌">
        <ShellContent Route="ChipExamplePage" ContentTemplate="{DataTemplate views:ChipExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ControlSwitch" Icon="🔘">
        <ShellContent Route="ControlSwitchExamplePage" ContentTemplate="{DataTemplate views:ControlSwitchExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Input" Icon="✏️">
        <ShellContent Route="InputExamplePage" ContentTemplate="{DataTemplate views:InputExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Spinner" Icon="🔄">
        <ShellContent Route="SpinnerExamplePage" ContentTemplate="{DataTemplate views:SpinnerExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ButtonCard" Icon="🔘">
        <ShellContent Route="ButtonCardExamplePage" ContentTemplate="{DataTemplate views:ButtonCardExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ButtonGrid" Icon="🔲">
        <ShellContent Route="ButtonGridExamplePage" ContentTemplate="{DataTemplate views:ButtonGridExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="DetailCard" Icon="📋">
        <ShellContent Route="DetailCardExamplePage" ContentTemplate="{DataTemplate views:DetailCardExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Dialog" Icon="💬">
        <ShellContent Route="DialogExamplePage" ContentTemplate="{DataTemplate views:DialogExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="EntityRow" Icon="📝">
        <ShellContent Route="EntityRowExamplePage" ContentTemplate="{DataTemplate views:EntityRowExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="EntityListGroup" Icon="📋">
        <ShellContent Route="EntityListGroupExamplePage" ContentTemplate="{DataTemplate views:EntityListGroupExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="SliderCard" Icon="🎚️">
        <ShellContent Route="SliderCardExamplePage" ContentTemplate="{DataTemplate views:SliderCardExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="StateBadge" Icon="🏷️">
        <ShellContent Route="StateBadgeExamplePage" ContentTemplate="{DataTemplate views:StateBadgeExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="ThemeSelector" Icon="🎨">
        <ShellContent Route="ThemeSelectorExamplePage" ContentTemplate="{DataTemplate views:ThemeSelectorExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="SizeSelector" Icon="📐">
        <ShellContent Route="SizeSelectorExamplePage" ContentTemplate="{DataTemplate views:SizeSelectorExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="SettingsGroup" Icon="⚙️">
        <ShellContent Route="SettingsGroupExamplePage" ContentTemplate="{DataTemplate views:SettingsGroupExamplePage}" />
    </FlyoutItem>

    <FlyoutItem Title="设置" Icon="🔧">
        <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="关于" Icon="ℹ️">
        <ShellContent Route="AboutPage" ContentTemplate="{DataTemplate views:AboutPage}" />
    </FlyoutItem>

</Shell>
